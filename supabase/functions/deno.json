{
  "tasks": {
    "test": "deno test --allow-read --allow-env _shared/",
    "check": "deno check _shared/ games/",
    "lint": "deno lint _shared/ games/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
